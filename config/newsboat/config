# ~/.config/newsboat/config --- the subscriptions feed for the `yt` workflow.
# Intentional + unread-only: you see only NEW-since-last-check videos from YOUR channels. Nothing else.
# urls (the channel list) is generated by `yt subs import`; priority channels come from priority.txt.

auto-reload no
reload-time 30
keep-articles-days 14          # 2-week cap
show-read-articles no          # only new-since-last-check show
show-read-feeds no
article-sort-order date-desc
text-width 100
confirm-exit no
cleanup-on-quit yes
prepopulate-query-feeds yes

# --- priority channels: `yt subs import` prefixes their feed title with ★; highlight it ---
highlight article "★.*" color220 default bold
highlight-article "feedtitle =~ \"★\"" color220 default

# --- open a feed video deliberately in the browser (ungoogled-chromium) ---
browser "yt browser '%u'"

# --- key bindings (intentional, few) ---
# a = add the selected video to watch-later (background download) AND mark it read (= "checked")
macro a set browser "yt add '%u' >/dev/null 2>&1 &" ; open-in-browser-and-mark-read ; set browser "yt browser '%u'"
# c = view the selected video's comments in a new terminal
macro c set browser "alacritty -e yt comments '%u' &" ; open-in-browser ; set browser "yt browser '%u'"
