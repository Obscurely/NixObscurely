# ~/.config/sway/config
#
# First-boot–focused Sway config. Goal: reliably start, show a bar, and open a
# terminal + neovim. Deliberately does NOT force output modes (a wrong mode can
# blank a display) — run `swaymsg -t get_outputs` on first boot, then uncomment
# and fill the ### Outputs block with the REAL connector names.

### Variables
set $mod Mod4
set $alt Mod1
set $term alacritty
set $shots $HOME/Pictures/screenshots

# Glacial colours (border bg text indicator child_border)
set $c_focus   #5E8DB8
set $c_unfocus #2E3B49
set $c_bg      #16202B
set $c_text    #CBD8EA
set $c_urgent  #E7B872

### Outputs
# Connector names from `swaymsg -t get_outputs`:
#   DP-1     = GIGA-BYTE MO32U24   (4K,   240Hz)  -> main   (middle)
#   HDMI-A-1 = GIGA-BYTE FI27Q     (1440p 144Hz)  -> right
#   HDMI-A-2 = ASUS VG248          (1080p 60Hz)   -> left
# Logical layout after scaling: [1080p 1920][4K@1.5 2560][1440p 2560]
set $mon_main  DP-1
set $mon_right HDMI-A-1
set $mon_left  HDMI-A-2

# 1080p side monitor: scale 1.25 (it sits further away — bigger UI). At 1.25 its
# logical size is 1536x864, so it must sit flush to DP-1's left edge (1920-1536=384)
# and centred ((1440-864)/2=288); otherwise a gap opens and the pointer can't reach it
# ("cursor stuck, as if off"). The quick-settings `relayout` script recomputes this
# from live sizes whenever the scale changes (and on enable), so this is just the default.
output $mon_left {
    mode 1920x1080@60Hz
    scale 1.25
    position 384 288
}
# 1080p side monitor OFF by default (Work default) — enable it from the quick-settings panel.
# (The kernel's `video=HDMI-A-2:d` force is lifted post-greeter in sway/init.sh.)
output $mon_left disable
output $mon_main {
    mode 3840x2160@240Hz
    scale 1.5
    position 1920 0
    render_bit_depth 10
}
output $mon_right {
    mode 2560x1440@144Hz
    scale 1
    position 4480 0
}

# Wallpaper: via swaybg in `exec` (sway does NOT expand env vars in `output bg`,
# but the exec shell does). Installed to $XDG_DATA_HOME/wallpaper by the theme.
exec swaybg -i "$XDG_DATA_HOME/wallpaper" -m fill

# Workspace -> output pinning
workspace 1  output $mon_main
workspace 2  output $mon_main
workspace 3  output $mon_main
workspace 4  output $mon_main
workspace 5  output $mon_main
workspace 6  output $mon_main
workspace 7  output $mon_right
workspace 8  output $mon_right
workspace 9  output $mon_right
workspace 10 output $mon_right
workspace 11 output $mon_right
workspace 12 output $mon_left

### Input
input type:pointer {
    accel_profile flat
    # 0 = libinput baseline (felt right). Range: -1 (slowest) .. 0 .. 1 (fastest).
    # The old X11 value 0.5 was compensation for the unscaled 4K; Wayland per-output
    # scaling removes the need. Tune live with:
    #   swaymsg 'input type:pointer pointer_accel <val>'
    pointer_accel 0
}
input type:keyboard {
    xkb_numlock enabled
    repeat_delay 250
    repeat_rate 45
}
seat * {
    xcursor_theme volantes_cursors 32
    hide_cursor when-typing enable
}

### Appearance
default_orientation horizontal
gaps inner 8
gaps outer 2
smart_gaps off
default_border pixel 2
default_floating_border pixel 2
titlebar_padding 1
font pango:Fira Sans 10

client.focused          $c_focus   $c_focus   $c_text $c_focus   $c_focus
client.focused_inactive $c_unfocus $c_unfocus $c_text $c_unfocus $c_unfocus
client.unfocused        $c_unfocus $c_bg      $c_text $c_unfocus $c_unfocus
client.urgent           $c_urgent  $c_urgent  $c_text $c_urgent  $c_urgent

focus_follows_mouse no
mouse_warping none

### Window rules
for_window [app_id="lxqt-policykit-agent"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [app_id="satty"] floating enable

### Keybindings
## session
bindsym $mod+$alt+r reload
bindsym $mod+$alt+q exit
bindsym $alt+Shift+x exec swaylock -f

## windows
bindsym $mod+w kill
bindsym $mod+Shift+w exec swaymsg -t get_tree | jq -r '.. | objects | select(.focused==true).pid // empty' | xargs -r kill -9
bindsym $mod+f fullscreen enable, floating disable
bindsym $mod+s fullscreen disable, floating enable
bindsym $mod+t fullscreen disable, floating disable

## focus (hjkl)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

## split direction (was bspwm preselect)
bindsym $mod+Ctrl+h split horizontal
bindsym $mod+Ctrl+l split horizontal
bindsym $mod+Ctrl+j split vertical
bindsym $mod+Ctrl+k split vertical

## resize mode
mode "resize" {
    bindsym Left  resize shrink width 40px
    bindsym Right resize grow width 40px
    bindsym Down  resize grow height 40px
    bindsym Up    resize shrink height 40px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

## workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+$alt+5 workspace number 6
bindsym $mod+6 workspace number 7
bindsym $mod+7 workspace number 8
bindsym $mod+8 workspace number 9
bindsym $mod+9 workspace number 10
bindsym $mod+0 workspace number 11
bindsym $mod+$alt+0 workspace number 12
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+$alt+Shift+5 move container to workspace number 6
bindsym $mod+Shift+6 move container to workspace number 7
bindsym $mod+Shift+7 move container to workspace number 8
bindsym $mod+Shift+8 move container to workspace number 9
bindsym $mod+Shift+9 move container to workspace number 10
bindsym $mod+Shift+0 move container to workspace number 11
bindsym $mod+$alt+Shift+0 move container to workspace number 12

## Workspace rules
#   follow=on : move the app there AND switch to it
#   assign    : open it there but DON'T switch focus (ws10 secondary, ws11 background)
# 1 terminal
for_window [app_id="^Alacritty$"]                     move container to workspace number 1,  workspace number 1
# 2 neovim
for_window [app_id="NeoVim"]                           move container to workspace number 2,  workspace number 2
# 3 primary browser
for_window [app_id="zen-beta"]                         move container to workspace number 3,  workspace number 3
# 4 secondary browsers (chromium + firefox + tor)
for_window [app_id="chromium-browser"]                move container to workspace number 4,  workspace number 4
for_window [app_id="^firefox$"]                        move container to workspace number 4,  workspace number 4
for_window [app_id="Tor Browser"]                      move container to workspace number 4,  workspace number 4
# 5 utilities
for_window [app_id="bruno"]                            move container to workspace number 5,  workspace number 5
for_window [app_id="virt-manager"]                     move container to workspace number 5,  workspace number 5
for_window [app_id="com.moonlight_stream.Moonlight"]   move container to workspace number 5,  workspace number 5
for_window [app_id="keymapp"]                          move container to workspace number 5,  workspace number 5
for_window [app_id="org.bleachbit.BleachBit"]         move container to workspace number 5,  workspace number 5
for_window [class="GParted"]                           move container to workspace number 5,  workspace number 5
for_window [app_id="org.kde.easyeffects"]             move container to workspace number 5,  workspace number 5
for_window [app_id="org.pulseaudio.pavucontrol"]      move container to workspace number 5,  workspace number 5
# 6 media / creative
for_window [app_id="mpv"]                              move container to workspace number 6,  workspace number 6
for_window [app_id="org.kde.kdenlive"]                move container to workspace number 6,  workspace number 6
for_window [app_id="com.obsproject.Studio"]           move container to workspace number 6,  workspace number 6
for_window [app_id="gimp"]                             move container to workspace number 6,  workspace number 6
for_window [app_id="org.xfce.ristretto"]              move container to workspace number 6,  workspace number 6
for_window [class="Audacity"]                          move container to workspace number 6,  workspace number 6
for_window [class="ONLYOFFICE"]                        move container to workspace number 6,  workspace number 6
for_window [app_id="YouTube"]                          move container to workspace number 6,  workspace number 6
# 7 dev / reference (dev terminal + Firefox Dev Edition)
for_window [app_id="^Dev$"]                            move container to workspace number 7,  workspace number 7
for_window [app_id="firefox-devedition"]              move container to workspace number 7,  workspace number 7
# 8 files
for_window [app_id="thunar"]                           move container to workspace number 8,  workspace number 8
for_window [app_id="Thunar"]                           move container to workspace number 8,  workspace number 8
for_window [app_id="xarchiver"]                        move container to workspace number 8,  workspace number 8
# 9 active-secondary (calc / monitoring) - assign: opens on the 2nd screen, keeps your main view
for_window [app_id="org.gnome.Calculator"]            move container to workspace number 9, workspace number 9
for_window [app_id="sysmon-btop"]                     move container to workspace number 9, workspace number 9
# 10 music
for_window [app_id="lollypop"]                         move container to workspace number 10, workspace number 10
for_window [class="Sonixd"]                            move container to workspace number 10, workspace number 10
# 11 background (ardour is GTK2/Xwayland -> both app_id+class hedged) + manual catch-all
for_window [app_id="Ardour"]                           move container to workspace number 11, workspace number 11
for_window [class="Ardour"]                            move container to workspace number 11, workspace number 11
for_window [app_id="org.qbittorrent.qBittorrent"]      move container to workspace number 11, workspace number 11
for_window [app_id="slack"]                            move container to workspace number 11, workspace number 11

## HDR Toggle on DP-1
bindsym $mod+F9 exec $XDG_CONFIG_HOME/sway/hdr-toggle.sh

## VRR toggle on DP-1
bindsym $mod+F10 exec $XDG_CONFIG_HOME/sway/vrr-toggle.sh

## Quick Settings panel (eww) — right-edge slide-out (displays/audio/system/modes)
bindsym $mod+comma exec bash $XDG_CONFIG_HOME/eww/scripts/qs-toggle

## apps
bindsym $mod+F11 exec setsid -f bash $HOME/.config/eww/scripts/launcher-toggle   # single-tap launcher thumb -> eww app launcher
bindsym $mod+F12 exec setsid -f bash $HOME/.config/eww/scripts/switcher-toggle   # double-tap launcher thumb -> window switcher

# clipboard history -> $mod+c (see below); $mod+v is nvim
bindsym $alt+Tab exec setsid -f bash $HOME/.config/eww/scripts/switcher-toggle

## clipboard history
bindsym $mod+shift+c exec setsid -f bash $HOME/.config/eww/scripts/clip-toggle   # eww clipboard history (replaces rofi)

## dev/reference workspace (ws7) — map your Moonlander key's tap / double-tap to these
bindsym $mod+d exec $term --class Dev --title Dev --working-directory $HOME --command tmux new-session -A -s dev
bindsym $mod+Shift+d exec firefox-devedition --name firefox-devedition

## screenshots (grim/slurp/satty)
bindsym Print       exec grim - | wl-copy
bindsym $mod+Print  exec grim "$shots/$(date +%Y%m%d_%H%M%S).png"
bindsym Ctrl+Print  exec grim -g "$(slurp -d)" - | satty -f - --copy-command wl-copy --early-exit

## media keys
bindsym XF86AudioMute        exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +2%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -2%
# Route through the mpris wrapper so they target the source pinned in the media popup
# (falls back to playerctl's default when nothing is pinned).
bindsym XF86AudioPlay        exec bash $XDG_CONFIG_HOME/eww/scripts/mpris play-pause
bindsym XF86AudioNext        exec bash $XDG_CONFIG_HOME/eww/scripts/mpris next
bindsym XF86AudioPrev        exec bash $XDG_CONFIG_HOME/eww/scripts/mpris previous

## application shortcuts

# terminal
bindsym $mod+Return exec $term --class Alacritty --title Alacritty --working-directory $HOME --command tmux new-session -A -s main
bindsym $mod+v exec $term --class NeoVim --title NeoVim --working-directory $HOME/Code --option window.padding.x=0 --option window.padding.y=0 --command tmux new-session -A -s code

# browsers
bindsym $mod+q exec zen-beta
bindsym $mod+shift+q exec chromium

# apps
bindsym $mod+e exec thunar
bindsym $mod+c exec gnome-calculator
bindsym $mod+x exec lollypop
bindsym $mod+shift+x exec sonixd
bindsym $mod+shift+v exec virt-manager

# media
bindsym $mod+m exec umpv
bindsym $mod+shift+m exec $term --class YouTube --title YouTube

### Bar — eww "glacial island", one window per monitor (config from the theme module).
# Single `exec` (not exec_always) so sway reloads don't stack eww daemons; the daemon
# auto-starts on the first `open`. Each window's output is passed via --arg, which drives
# both `:monitor` and the per-monitor workspace filter.
exec eww open-many bar:dp1 bar:hdmi1 \
    --arg "dp1:output=DP-1" --arg "hdmi1:output=HDMI-A-1"

### NixOS integration
# We ship an authoritative ~/.config/sway/config, so sway reads THIS instead of
# /etc/sway/config. Pull in the NixOS drop-in, which runs
# `dbus-update-activation-environment` + `systemctl --user import-environment`
# and starts sway-session.target — without this, xdg-desktop-portal
# (screenshare/file-picker), the systemd user session and pinentry misbehave.
include /etc/sway/config.d/*

### Autostart
exec lxqt-policykit-agent
exec mako
exec wl-paste --watch cliphist store

# swayidle: NO auto-lock. Just turn the screen off at 10min (OLED burn-in guard).
# Lock manually with $alt+Shift+x. Still locks before suspend (security) — remove
# the before-sleep line too if you don't want even that.
exec swayidle -w \
    timeout 600 'swaymsg "output * power off"' \
    resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f'

# Your own hook (safe no-op by default)
exec_always $XDG_CONFIG_HOME/sway/init.sh
