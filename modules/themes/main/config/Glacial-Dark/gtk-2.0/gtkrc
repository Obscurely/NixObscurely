# Glacial-Dark — GTK2 theme (Murrine engine)
# Flat, icy-blue dark. Legacy layer for the few remaining GTK2 apps; palette matches the
# GTK3/GTK4 layers and the eww "glacial" desktop.
#
# Requires the "murrine" engine at RENDER time (nixpkgs: gtk-engine-murrine, wired onto GTK_PATH).
# If the engine can't be resolved GTK2 silently falls back to the default engine and the flat
# look is lost — so verify the Nix wiring, not just that the package is installed.
#
# Flat-but-rounded recipe: gradient_shades={1,1,1,1} + reliefstyle=0 + roundness>0.

# ============================================================
# PALETTE  (opaque glacial — apps have no wallpaper behind them)
#   bg  #0E1420  fg  #CBD8EA   base #0A0F18  text #CBD8EA
#   accent #8CC6F2 (selected_bg)  on-accent #0B111C (selected_fg)
#   tooltip/raised #1A2534
# ============================================================
gtk-color-scheme = "bg_color:#0E1420\nfg_color:#CBD8EA\nbase_color:#0A0F18\ntext_color:#CBD8EA\nselected_bg_color:#8CC6F2\nselected_fg_color:#0B111C\ntooltip_bg_color:#1A2534\ntooltip_fg_color:#CBD8EA\nlink_color:#8CC6F2"

gtk-auto-mnemonics = 1
gtk-primary-button-warps-slider = 1

# ============================================================
# DEFAULT STYLE  --  flatness + full per-state color arrays
# ============================================================
style "default" {
    xthickness = 1
    ythickness = 1

    GtkButton         ::child-displacement-x = 0
    GtkButton         ::child-displacement-y = 0
    GtkButton         ::default-border       = {0, 0, 0, 0}
    GtkCheckButton    ::indicator-size       = 15
    GtkRadioButton    ::indicator-size       = 15
    GtkMenuBar        ::internal-padding      = 0
    GtkExpander       ::expander-size         = 14
    GtkTreeView       ::odd_row_color         = shade(1.06, @base_color)
    GtkRange          ::trough-border         = 0
    GtkRange          ::slider-width          = 14
    GtkScrollbar      ::min-slider-length     = 40
    GtkScrollbar      ::slider-width          = 11
    GtkScrollbar      ::trough-border         = 0
    GtkScrollbar      ::has-backward-stepper  = 0
    GtkScrollbar      ::has-forward-stepper   = 0
    GtkScrolledWindow ::scrollbar-spacing     = 0
    GtkWidget         ::link-color            = @link_color
    GtkWidget         ::focus-padding         = 1
    GtkWidget         ::focus-line-width      = 1

    # ---- per-state color arrays ----
    bg[NORMAL]        = @bg_color
    bg[PRELIGHT]      = shade(1.14, @bg_color)
    bg[ACTIVE]        = shade(0.94, @bg_color)
    bg[SELECTED]      = @selected_bg_color
    bg[INSENSITIVE]   = shade(1.04, @bg_color)

    fg[NORMAL]        = @fg_color
    fg[PRELIGHT]      = @fg_color
    fg[ACTIVE]        = @fg_color
    fg[SELECTED]      = @selected_fg_color
    fg[INSENSITIVE]   = shade(0.60, @fg_color)

    base[NORMAL]      = @base_color
    base[PRELIGHT]    = @base_color
    base[ACTIVE]      = @selected_bg_color
    base[SELECTED]    = @selected_bg_color
    base[INSENSITIVE] = shade(1.06, @bg_color)

    text[NORMAL]      = @text_color
    text[PRELIGHT]    = @text_color
    text[ACTIVE]      = @selected_fg_color
    text[SELECTED]    = @selected_fg_color
    text[INSENSITIVE] = shade(0.55, @text_color)

    engine "murrine" {
        animation          = FALSE
        arrowstyle         = 1
        border_shades      = {1.0, 1.0}
        colorize_scrollbar = TRUE
        comboboxstyle      = 0
        contrast           = 0.40      # faint glacial borders (0.0 would remove them)
        expanderstyle      = 0
        focusstyle         = 2
        focus_color        = @selected_bg_color
        glazestyle         = 0
        glow_shade         = 1.0
        glowstyle          = 0
        gradient_shades    = {1.0, 1.0, 1.0, 1.0}
        highlight_shade    = 1.0
        lightborder_shade  = 1.0
        lightborderstyle   = 0
        listviewheaderstyle= 0
        listviewstyle      = 0
        menubaritemstyle   = 0
        menubarstyle       = 0
        menuitemstyle      = 0
        menustyle          = 0
        progressbarstyle   = 0
        reliefstyle        = 0
        rgba               = FALSE
        roundness          = 5         # flat shading, rounded corners (glacial)
        scrollbarstyle     = 0
        separatorstyle     = 1
        shadow_shades      = {1.0, 1.0}
        sliderstyle        = 0
        stepperstyle       = 0
        textstyle          = 0
        toolbarstyle       = 0
        trough_shades      = {1.0, 1.0}
    }
}

# ============================================================
# PER-WIDGET OVERRIDES
# ============================================================
style "button" = "default" {
    xthickness = 4
    ythickness = 4
    bg[NORMAL]      = #1A2534   # raised card
    bg[PRELIGHT]    = #24344A   # hover (one step brighter)
    bg[ACTIVE]      = @selected_bg_color
    bg[INSENSITIVE] = shade(1.04, @bg_color)
    engine "murrine" {
        contrast        = 0.40
        gradient_shades = {1.0, 1.0, 1.0, 1.0}
        reliefstyle     = 0
        roundness       = 5
    }
}

style "entry" = "default" {
    xthickness = 5
    ythickness = 5
    base[NORMAL]      = @base_color
    base[INSENSITIVE] = shade(1.06, @bg_color)
    engine "murrine" {
        contrast      = 0.55       # entries want a slightly more visible edge
        roundness     = 5
        border_shades = {1.0, 1.0}
        focusstyle    = 2
    }
}

style "menubar" = "default" {
    ythickness = 3
    bg[NORMAL] = @bg_color
    fg[NORMAL] = @fg_color
    engine "murrine" {
        menubarstyle    = 0
        gradient_shades = {1.0, 1.0, 1.0, 1.0}
        contrast        = 0.0
    }
}

style "menu" = "default" {
    xthickness = 1
    ythickness = 3
    bg[NORMAL] = #141C29        # menu surface, a touch above window bg
    engine "murrine" {
        menustyle       = 0
        roundness       = 8
        gradient_shades = {1.0, 1.0, 1.0, 1.0}
        contrast        = 0.40
    }
}

style "menu_item" = "default" {
    xthickness   = 3
    ythickness   = 5
    fg[PRELIGHT] = @selected_fg_color
    bg[SELECTED] = @selected_bg_color
    engine "murrine" {
        menuitemstyle   = 0
        gradient_shades = {1.0, 1.0, 1.0, 1.0}
        roundness       = 5
    }
}

style "scrollbar" = "default" {
    bg[NORMAL]   = @selected_bg_color               # slider (colorize_scrollbar=TRUE reads these)
    bg[PRELIGHT] = shade(1.15, @selected_bg_color)
    bg[ACTIVE]   = shade(0.90, @selected_bg_color)
    bg[INSENSITIVE] = shade(1.04, @bg_color)
    engine "murrine" {
        roundness       = 8
        contrast        = 0.0
        trough_shades   = {1.0, 1.0}
        border_shades   = {1.0, 1.0}
        gradient_shades = {1.0, 1.0, 1.0, 1.0}
        scrollbarstyle  = 0
    }
}

style "tooltip" = "default" {
    xthickness = 8
    ythickness = 5
    bg[NORMAL] = @tooltip_bg_color
    fg[NORMAL] = @tooltip_fg_color
    engine "murrine" {
        border_shades = {1.0, 1.0}
        roundness     = 8
    }
}

style "treeview" = "default" {
    base[SELECTED] = @selected_bg_color             # focused selected row
    base[ACTIVE]   = shade(0.80, @selected_bg_color) # unfocused selected row
    text[SELECTED] = @selected_fg_color
    text[ACTIVE]   = @selected_fg_color
    engine "murrine" {
        gradient_shades = {1.0, 1.0, 1.0, 1.0}
        listviewstyle   = 0
        contrast        = 0.0
    }
}

style "treeview_header" = "button" {
    ythickness   = 3
    bg[NORMAL]   = shade(0.94, @bg_color)
    bg[PRELIGHT] = shade(1.00, @bg_color)
    bg[ACTIVE]   = shade(0.90, @bg_color)
    engine "murrine" {
        listviewheaderstyle = 0
        gradient_shades     = {1.0, 1.0, 1.0, 1.0}
        contrast            = 0.30
        roundness           = 0
    }
}

style "progressbar" = "default" {
    xthickness = 0
    ythickness = 0
    fg[PRELIGHT] = @selected_fg_color
    bg[NORMAL]   = shade(1.10, @bg_color)
    bg[SELECTED] = @selected_bg_color
    engine "murrine" {
        roundness        = 8
        gradient_shades  = {1.0, 1.0, 1.0, 1.0}
        progressbarstyle = 0
    }
}

# ============================================================
# BINDINGS  (order matters: default first, specifics after)
# ============================================================
class "GtkWidget"                              style "default"
class "GtkButton"                              style "button"
class "GtkEntry"                               style "entry"
class "GtkOldEditable"                         style "entry"
class "GtkSpinButton"                          style "entry"
class "GtkScrollbar"                           style "scrollbar"
class "GtkMenuBar"                             style "menubar"
class "GtkMenu"                                style "menu"
class "GtkProgressBar"                         style "progressbar"
widget_class "*<GtkButton>*"                   style "button"
widget_class "*<GtkMenuItem>*"                 style "menu_item"
widget_class "*<GtkMenuBar>.<GtkMenuItem>*"    style "menu_item"
widget_class "*<GtkTreeView>*"                 style "treeview"
widget_class "*.<GtkTreeView>.<GtkButton>"     style "treeview_header"
widget_class "*.<GtkCList>.<GtkButton>"        style "treeview_header"
widget_class "*<GtkProgressBar>*"              style "progressbar"
widget "gtk-tooltip*"                          style "tooltip"
widget "gtk-tooltips"                          style "tooltip"
