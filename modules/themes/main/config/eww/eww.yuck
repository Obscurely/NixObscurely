;; =====================================================================
;;  eww bar — glacial island (Sway/Wayland)
;;  Icons are injected from codepoints into the {{I_*}} placeholders by the
;;  inject step; do not hand-type the glyph bytes (some drop in transit).
;; =====================================================================

;; Quick Settings + Audio + Media + Date/Time popups — separate windows, same daemon
(include "quicksettings.yuck")
(include "audio.yuck")
(include "media.yuck")
(include "datetime.yuck")
(include "sysmon.yuck")
(include "network.yuck")
(include "launcher.yuck")
(include "switcher.yuck")
(include "clipboard.yuck")

;; ------------------------------- data --------------------------------
(deflisten workspaces :initial "[]" `bash $HOME/.config/eww/scripts/workspaces`)
(deflisten player :initial "{\"status\":\"Stopped\",\"title\":\"\",\"artist\":\"\"}" `bash $HOME/.config/eww/scripts/player`)
(defpoll   volume   :interval "500ms" :initial "0"     `bash $HOME/.config/eww/scripts/volume`)
(defpoll   network  :interval "2s"    :initial "{}"    `bash $HOME/.config/eww/scripts/network`)
(defpoll   cputemp  :interval "3s"    :initial "0"     `bash $HOME/.config/eww/scripts/temp`)
(defpoll   clock    :interval "10s"   :initial "--:--" `date +'%H:%M'`)
(defvar    clock_date false)                                       ; bar clock shows date instead of time
(defpoll   datestr  :interval "600s"  :initial ""      `date +'%a %-d %b'`)       ; inline toggle date "Sun 2 Aug"
(defpoll   fulldate :interval "600s"  :initial ""      `date +'%A, %-d %B %Y'`)   ; popup full date

;; ---------------------------- sub-widgets ----------------------------
(defwidget statitem [icon val]
  (box :class "statitem" :space-evenly false :spacing 10
    (label :class "s-icon" :text icon)
    (label :class "s-val"  :text val)))

(defwidget sep [] (label :class "sep" :text "●"))

(defwidget workspaces [output]
  (box :class "mod ws" :space-evenly false :halign "start" :spacing 2
    (for ws in {jq(workspaces, '[.[] | select(.output == "' + output + '")]')}
      (button
        :class "wsbtn ${ws.urgent ? "urgent" : ws.focused ? "focused" : ws.visible ? "visible" : ws.occupied ? "occupied" : "empty"}"
        :onclick "swaymsg workspace number ${ws.num}"
        (label :text {ws.icon})))))

(defwidget sensors []
  (eventbox :class "mod sensors"
            :onclick "setsid -f bash $HOME/.config/eww/scripts/monitor"
            :onrightclick "setsid -f bash $HOME/.config/eww/scripts/sysmon-toggle"
    (box :class "sensors-inner" :space-evenly false :spacing 16
      (statitem :icon "󰄧"  :val "${round(EWW_CPU.avg, 0)}%")
      (statitem :icon "󰍛"  :val "${round(EWW_RAM.used_mem / 1073741824, 1)}G")
      (statitem :icon "󰆼" :val "${round(EWW_DISK['/'].free / 1000000000, 0)}G")
      (statitem :icon "󰔏" :val "${cputemp}°"))))

(defwidget media []
  (eventbox :class "mod media ${player.status == 'Playing' ? 'playing' : player.status == 'Paused' ? 'paused' : 'idle'}"
            :visible {player.title != ""}
            :onclick "setsid -f bash $HOME/.config/eww/scripts/mpris play-pause"
            :onrightclick "setsid -f bash $HOME/.config/eww/scripts/media-toggle"
    (box :class "media-inner" :space-evenly false :spacing 8
      (label :class "m-icon" :text "󰝚")
      (box :class "m-text" :space-evenly false :spacing 0
        (label :class "m-artist" :visible {player.artist != ""} :limit-width 30 :show-truncated true :text {player.artist})
        (label :class "m-dash"   :visible {player.artist != ""} :text "—")
        (label :class "m-title" :limit-width 42 :show-truncated true :text {player.title})))))

(defwidget audio []
  (eventbox :class "mod audio" :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle"
            :onrightclick "setsid -f bash $HOME/.config/eww/scripts/audio-toggle"
    (box :class "audio-inner" :space-evenly false :spacing 10
      (label :class {volume < 0 ? "s-icon warn" : "s-icon"} :text {volume < 0 ? "󰝟" : "󰕾"})
      (label :class "s-val" :text {volume < 0 ? "muted" : "${volume}%"}))))

(defwidget net []
  (eventbox :class "mod net"
            :onclick "setsid -f bash $HOME/.config/eww/scripts/netip-copy"
            :onrightclick "setsid -f bash $HOME/.config/eww/scripts/net-toggle"
    (box :class "net-inner" :space-evenly false :spacing 12
      (box :visible {network.connected} :space-evenly false :spacing 12
        (box :class "netgrp" :space-evenly false :spacing 5
          (label :class "s-icon" :text "↓")
          (label :class "s-val netspd" :text {network.down}))
        (box :class "netgrp" :space-evenly false :spacing 5
          (label :class "s-icon" :text "↑")
          (label :class "s-val netspd" :text {network.up})))
      (box :visible {network.connected == false} :space-evenly false :spacing 8
        (label :class "s-icon warn" :text "󰒎")
        (label :class "s-val" :text "off")))))

(defwidget clockw []
  (eventbox :class "mod clock"
            :onclick "eww update clock_date=${!clock_date}"
            :onrightclick "setsid -f bash $HOME/.config/eww/scripts/datetime-toggle"
    (box :class "clock-inner" :space-evenly false :spacing 10
      (label :class "s-icon" :text {clock_date ? "󰃭" : "󰅐"})
      (label :class "s-val"  :text {clock_date ? datestr : clock}))))

(defwidget launcher []
  (button :class "mod iconbtn launcher" :onclick "setsid -f bash $HOME/.config/eww/scripts/launcher-toggle"
    (label :text "󱄅")))

(defwidget power []
  (button :class "mod iconbtn power" :onclick "$DOTFILES_BIN/rofi/powermenu &"
          :onrightclick "setsid -f bash $HOME/.config/eww/scripts/qs-toggle"
    (label :text "󰐥")))

;; ------------------------------- bar ---------------------------------
(defwidget bar [output]
  (centerbox :class "bar-root" :orientation "h"
    (box :class "sec sec-left" :halign "start" :space-evenly false :spacing 8
      (launcher)
      (sep)
      (workspaces :output output)
      (sep)
      (sensors))
    (box :class "sec sec-center" :halign "center" :space-evenly false
      (media))
    (box :class "sec sec-right" :halign "end" :space-evenly false :spacing 8
      (audio)
      (sep)
      (net)
      (sep)
      (clockw)
      (sep)
      (power))))

;; ------------------------------ windows ------------------------------
(defwindow bar [output]
  :monitor output
  :stacking "fg"
  :exclusive true
  :focusable false
  :namespace "eww-bar"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "42px" :anchor "top center")
  (bar :output output))
