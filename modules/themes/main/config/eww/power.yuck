;; =====================================================================
;;  Power menu — glacial centered modal. Left-click the bar power icon (power-toggle).
;;  Actions: Lock / Log out / Restart / Power off — each behind a Confirm/Cancel step.
;;  One card, two states, driven by `power_pending` ("" = action row; a key = confirm view).
;;  Replaces the rofi powermenu (the last rofi consumer).
;; =====================================================================

(defvar power_pending "")   ; "" | lock | logout | reboot | poweroff

(defwidget pm-action [key icon label]
  (button :class "pm-btn" :onclick "eww update power_pending=${key}"
    (box :class "pm-btn-in" :orientation "v" :space-evenly false :spacing 6 :valign "center"
      (label :class "pm-btn-icon" :text icon)
      (label :class "pm-btn-lbl" :text label))))

(defwidget power-root []
  (box :class "qs-root pm-root" :orientation "v" :space-evenly false
    ;; -- State A: action row --
    (box :class "pm-row" :visible {power_pending == ""} :space-evenly true :spacing 10 :halign "center"
      (pm-action :key "lock"     :icon "󰌾" :label "Lock")
      (pm-action :key "logout"   :icon "󰍃" :label "Log out")
      (pm-action :key "reboot"   :icon "󰜉" :label "Restart")
      (pm-action :key "poweroff" :icon "󰐥" :label "Power off"))

    ;; -- State B: confirmation --
    (box :class "pm-confirm ${power_pending == "reboot" || power_pending == "poweroff" ? "danger" : ""}"
         :visible {power_pending != ""} :orientation "v" :space-evenly false :spacing 14 :halign "center"
      (label :class "pm-confirm-icon"
             :text {power_pending == "poweroff" ? "󰐥" :
                    power_pending == "reboot"   ? "󰜉" :
                    power_pending == "logout"   ? "󰍃" : "󰌾"})
      (label :class "pm-confirm-q"
             :text {power_pending == "poweroff" ? "Power off?" :
                    power_pending == "reboot"   ? "Restart?" :
                    power_pending == "logout"   ? "Log out?" : "Lock the screen?"})
      (box :class "pm-confirm-btns" :space-evenly false :spacing 12 :halign "center"
        (button :class "pm-cancel" :onclick "eww update power_pending=''"
          (box :class "pm-cbtn-in" :space-evenly false :spacing 8
            (label :text "󰅖") (label :text "Cancel")))
        (button :class "pm-ok" :onclick "setsid -f bash $HOME/.config/eww/scripts/power-run ${power_pending}"
          (box :class "pm-cbtn-in" :space-evenly false :spacing 8
            (label :text "󰄬") (label :text "Confirm")))))))

(defwindow power
  :monitor "DP-1"
  :stacking "overlay"
  :exclusive false
  :focusable false
  :geometry (geometry :x "0" :y "300px" :width "440px" :anchor "top center")
  (power-root))
