#!/usr/bin/env bash
# Toggle the audio popup (right-click the bar audio module). Closes on Escape, click-away (the
# backdrop), or re-click; opening it closes any other open bar popup.
s="$HOME/.config/eww/scripts"
if eww active-windows 2>/dev/null | grep -q '^audio:'; then
  bash "$s/popup-close"
else
  # seed the optimistic slider vars from the current volumes before showing
  ov=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%.0f", $2*100}')
  iv=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | awk '{printf "%.0f", $2*100}')
  eww update avol="${ov:-50}" aivol="${iv:-50}" appvols="{}"
  bash "$s/popup-open" audio
fi
