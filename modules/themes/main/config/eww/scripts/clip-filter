#!/usr/bin/env python3
# Filter the cached clipboard list (eww-clips.json). Args=query. Empty->newest N. Non-empty->fzf
# picks the fuzzy MATCHES, but results are returned in RECENCY order (clip-list is newest-first),
# never fzf-relevance order — you want the most recent thing matching your search. Capped at N.
import json, os, subprocess, sys
CACHE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "eww-clips.json")
SEP = "\x1f"; N = 8
try: items = json.load(open(CACHE))
except Exception: items = []
q = " ".join(sys.argv[1:]).strip()
if not q:
    print(json.dumps(items[:N])); sys.exit()
lines = "".join(f"{i}{SEP}{it['search']}\n" for i, it in enumerate(items))
try:
    r = subprocess.run(["fzf", "--filter", q, "--delimiter", SEP, "--nth", "2"],
                       input=lines, capture_output=True, text=True, timeout=3)
    idx = sorted(int(l.split(SEP, 1)[0]) for l in r.stdout.splitlines() if l)  # recency, not relevance
except Exception: idx = []
print(json.dumps([items[i] for i in idx[:N]]))
