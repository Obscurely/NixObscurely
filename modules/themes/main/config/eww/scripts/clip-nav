#!/usr/bin/env bash
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/eww-cnav.lock"; flock 9
sel=$(eww get csel 2>/dev/null); sel=${sel:-0}
len=$(eww get cresults 2>/dev/null | python3 -c 'import sys,json
try: print(len(json.load(sys.stdin)))
except: print(0)')
[ "${len:-0}" -eq 0 ] && exit 0
case "$1" in
  down) sel=$((sel+1)); [ "$sel" -ge "$len" ] && sel=$((len-1)) ;;
  up)   sel=$((sel-1)); [ "$sel" -lt 0 ] && sel=0 ;;
esac
eww update csel="$sel"
