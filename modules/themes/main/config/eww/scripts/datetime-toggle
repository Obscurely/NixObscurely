#!/usr/bin/env bash
# Toggle the date/time (calendar + weather) popup — right-click the bar clock. Closes on Escape,
# click-away (the backdrop), or re-click; opening it closes any other open bar popup.
s="$HOME/.config/eww/scripts"
if eww active-windows 2>/dev/null | grep -q '^datetime:'; then
  bash "$s/popup-close"
else
  bash "$s/popup-open" datetime
fi
