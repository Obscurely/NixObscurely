#!/usr/bin/env bash
# Move the launcher selection (Down/Up/Tab while open). $1 = up|down.
# Fast path: sel+len live in a runtime state file (written by launcher-filter when the results
# change), so a held key costs only flock + read + one `eww update` — no `eww get`/python spawn
# per press (that was ~84ms/press and lagged under key-repeat; this is ~26ms).
f="${XDG_RUNTIME_DIR:-/tmp}/eww-lnav"
exec 9>"$f.lock"; flock 9
read -r sel len < "$f" 2>/dev/null; sel=${sel:-0}; len=${len:-0}
[ "${len:-0}" -le 0 ] && exit 0
case "$1" in
  down) sel=$((sel + 1)); [ "$sel" -ge "$len" ] && sel=$((len - 1)) ;;
  up)   sel=$((sel - 1)); [ "$sel" -lt 0 ] && sel=0 ;;
esac
printf '%s %s\n' "$sel" "$len" > "$f"
eww update lsel="$sel"
