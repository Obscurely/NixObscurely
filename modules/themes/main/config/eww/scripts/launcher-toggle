#!/usr/bin/env bash
# Toggle the app launcher (logo left-click / keybind). popup-open closes any other open widget
# (universal sibling-close), raises the click-away backdrop, opens the focused window, and binds
# Escape->popup-close; here we add the launcher's own nav keys. Close = popup-close (unbinds all).
s="$HOME/.config/eww/scripts"

if eww active-windows 2>/dev/null | grep -q '^launcher:'; then
  bash "$s/popup-close"
else
  # refresh the index in the BACKGROUND so opening never waits (sync build only if no cache yet)
  [ -f "${XDG_RUNTIME_DIR:-/tmp}/eww-apps.json" ] || python3 "$s/launcher-index"
  setsid -f python3 "$s/launcher-index" >/dev/null 2>&1
  eww update lmode="apps" lcalc="" lsel=0 lresults="$(python3 "$s/launcher-filter")"
  bash "$s/popup-open" launcher
  swaymsg "bindsym Return exec setsid -f bash $s/launcher-run" >/dev/null 2>&1
  swaymsg "bindsym Down   exec bash $s/launcher-nav down"   >/dev/null 2>&1
  swaymsg "bindsym Up     exec bash $s/launcher-nav up"     >/dev/null 2>&1
  swaymsg "bindsym Tab    exec bash $s/launcher-nav down"   >/dev/null 2>&1
fi
