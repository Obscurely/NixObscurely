#!/usr/bin/env bash
# Toggle the network popup (right-click the bar's network module). Escape closes it while open;
# the binding is removed on close. Instant, :focusable false.
self="$HOME/.config/eww/scripts/net-toggle"

if eww active-windows 2>/dev/null | grep -q '^network:'; then
  swaymsg unbindsym Escape 2>/dev/null
  eww close network
else
  eww open network
  swaymsg "bindsym Escape exec bash $self" 2>/dev/null
fi
