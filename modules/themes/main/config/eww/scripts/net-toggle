#!/usr/bin/env bash
# Toggle the network popup (right-click the bar network module). Closes on Escape, click-away
# (the backdrop), or re-click; opening it closes any other open bar popup.
s="$HOME/.config/eww/scripts"
if eww active-windows 2>/dev/null | grep -q '^network:'; then
  bash "$s/popup-close"
else
  bash "$s/popup-open" network
fi
