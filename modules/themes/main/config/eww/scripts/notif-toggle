#!/usr/bin/env bash
# Toggle the notification center (right-click the logo). Closes on Escape, click-away (the
# backdrop), or re-click; opening it closes any other open bar popup.
s="$HOME/.config/eww/scripts"
if eww active-windows 2>/dev/null | grep -q '^notifications:'; then
  bash "$s/popup-close"
else
  eww update nresults="$(python3 "$s/notif-list")"   # seed so it opens populated (no first-poll wait)
  bash "$s/popup-open" notifications
fi
