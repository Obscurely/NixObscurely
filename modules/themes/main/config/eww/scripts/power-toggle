#!/usr/bin/env bash
# Toggle the power menu. Mirrors qs-toggle: reset to the action row on open, bind Escape to
# re-run this (which closes when open). :focusable false, so Escape is a sway bind.
self="$HOME/.config/eww/scripts/power-toggle"

if eww active-windows 2>/dev/null | grep -q '^power:'; then
  swaymsg unbindsym Escape 2>/dev/null
  eww close power
else
  eww update power_pending=""      # always open on the action row, never a stale confirm
  eww open power
  swaymsg "bindsym Escape exec bash $self" 2>/dev/null
fi
