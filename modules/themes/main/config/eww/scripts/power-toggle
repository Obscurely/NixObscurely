#!/usr/bin/env bash
# Toggle the power menu (left-click the bar power icon). popup-open handles sibling-close + backdrop
# + Escape; here we add the arrow/Tab/Return nav keys. Close (Escape/click-away/re-click) = popup-close,
# which unbinds the whole keyset (incl these arrows). Reset to the action row + cursor 0 on open.
s="$HOME/.config/eww/scripts"
if eww active-windows 2>/dev/null | grep -q '^power:'; then
  bash "$s/popup-close"
else
  eww update power_pending="" power_sel=0
  bash "$s/popup-open" power
  swaymsg "bindsym Left   exec bash $s/power-nav prev" >/dev/null 2>&1
  swaymsg "bindsym Up     exec bash $s/power-nav prev" >/dev/null 2>&1
  swaymsg "bindsym Right  exec bash $s/power-nav next" >/dev/null 2>&1
  swaymsg "bindsym Down   exec bash $s/power-nav next" >/dev/null 2>&1
  swaymsg "bindsym Tab    exec bash $s/power-nav next" >/dev/null 2>&1
  swaymsg "bindsym Return exec bash $s/power-select"   >/dev/null 2>&1
fi
