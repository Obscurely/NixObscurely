#!/usr/bin/env bash
# Toggle the quick-settings panel (right-click the bar power icon / $mod+comma). Closes on Escape,
# click-away (the backdrop), or re-click; opening it closes any other open bar popup (sibling-close).
s="$HOME/.config/eww/scripts"
if eww active-windows 2>/dev/null | grep -q '^quicksettings:'; then
  bash "$s/popup-close"
else
  bash "$s/popup-open" quicksettings
fi
