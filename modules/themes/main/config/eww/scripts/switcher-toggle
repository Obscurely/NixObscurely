#!/usr/bin/env bash
# Toggle the window switcher ($mod+F12 / double-tap launcher thumb). On open: snapshot the window
# list, seed, open focused, bind nav keys in sway (letters fall through to the input).
s="$HOME/.config/eww/scripts"
if eww active-windows 2>/dev/null | grep -q '^switcher:'; then
  bash "$s/switcher-close"
else
  wins="$(python3 "$s/switcher-list")"
  printf '%s' "$wins" > "${XDG_RUNTIME_DIR:-/tmp}/eww-windows.json"
  eww update sresults="$wins" ssel=0
  eww open switcher
  swaymsg "bindsym Escape exec bash $s/switcher-close"        >/dev/null 2>&1
  swaymsg "bindsym Return exec setsid -f bash $s/switcher-run" >/dev/null 2>&1
  swaymsg "bindsym Down   exec bash $s/switcher-nav down"     >/dev/null 2>&1
  swaymsg "bindsym Up     exec bash $s/switcher-nav up"       >/dev/null 2>&1
  swaymsg "bindsym Tab    exec bash $s/switcher-nav down"     >/dev/null 2>&1
fi
