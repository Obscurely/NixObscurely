#!/usr/bin/env python3
# Quick Settings — MODES + SYSTEM live state (defpoll target). Emits {mode, idle, dnd}.
#   mode -> inferred current scene from live display state (see scripts/mode)
#   idle -> pidof swayidle (boot default ON; toggled at runtime)
#   dnd  -> makoctl mode contains 'do-not-disturb'
# EasyEffects state moved to scripts/audio when audio left Quick Settings for the
# right-click-volume audio widget.
import json
import subprocess


def out(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=2).stdout
    except Exception:
        return ""


def running(name):
    # pidof matches argv[0]'s basename, so it catches nix-wrapped binaries too.
    return subprocess.run(["pidof", name], capture_output=True).returncode == 0


def sway_outputs():
    try:
        return {o["name"]: o for o in json.loads(out(["swaymsg", "-t", "get_outputs", "-r"]))}
    except Exception:
        return {}


def active_mode(outs):
    # Infer the current scene preset from live display state (see scripts/mode).
    dp1 = outs.get("DP-1", {})
    if not dp1.get("active"):
        return ""
    hdr = bool(dp1.get("hdr"))
    vrr = dp1.get("adaptive_sync_status") == "enabled"
    h1 = bool(outs.get("HDMI-A-1", {}).get("active"))
    h2 = bool(outs.get("HDMI-A-2", {}).get("active"))
    if hdr and vrr:
        return "game"
    if hdr:
        return "cinema"
    if not vrr and h1 and not h2:
        return "work"
    if not vrr and not h1 and not h2:
        return "focus"
    return ""


print(json.dumps({
    "mode": active_mode(sway_outputs()),
    "idle": running("swayidle"),
    "dnd": "do-not-disturb" in out(["makoctl", "mode"]),
}), flush=True)
